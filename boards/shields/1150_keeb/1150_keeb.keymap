#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                // 1 2 3 4 5 6 7 8 9 0 +/? Backspace
                &kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp MINUS  &kp BSPC

                // Esc QWERTY row norwegian
                &kp ESC    &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P      &kp LBKT

                // Tab ASDF row
                &kp TAB    &kp A      &kp S      &kp D      &kp F      &kp G      &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT

                // Shift ZXCV row
                &kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M      &kp COMMA  &kp DOT    &kp SLASH   &kp RSHFT

                // Bottom row, 10 keys
                &kp LCTRL  &kp LGUI   &kp LALT      &mo 1   &kp SPACE             &kp SPACE   &mo 1      &kp BSPC     &kp DEL    &kp RET
            >;
        };

        fn_layer {
            bindings = <
                // Number row becomes F row
                &kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12

                // WASD becomes arrows: W=Up
                &trans     &trans     &kp UP     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans

                // A=Left, S=Down, D=Right
                &trans     &kp LEFT   &kp DOWN   &kp RIGHT  &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans

                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans

                &trans     &trans     &trans     &trans     &trans                &trans     &trans     &trans     &trans     &trans
            >;
        };
    };
};